# ==============================================================================
# Quranific Portal — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in real values for production.
# Local development uses the defaults shown after the = sign.
# NEVER commit a .env with real secrets to version control.
# ==============================================================================

# ----- Django -----
# ⚠️  PRODUCTION OVERRIDES — change ALL of these before deploying to OCI:
#   DJANGO_DEBUG=False
#   DJANGO_SECRET_KEY=<50+ random chars — never the default>
#   DJANGO_ALLOWED_HOSTS=your-oci-hostname.com,www.your-oci-hostname.com
#   DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
# Development defaults (safe ONLY on localhost):
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
# Dev: leave blank to use localhost:5173/3000 defaults. Prod: set to https://your-frontend.com
DJANGO_CORS_ALLOWED_ORIGINS=

# ----- PostgreSQL (must match docker-compose.yml) -----
POSTGRES_DB=quranific
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Seconds to keep a DB connection alive per gunicorn worker (0 = disable pooling for local dev)
DB_CONN_MAX_AGE=60

# ----- JWT Token Lifetimes -----
JWT_ACCESS_TOKEN_LIFETIME_DAYS=1
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ----- LiveKit (WebRTC Video Server) -----
# R-R3-05: devkey/secret removed. MUST match the keys: entry in livekit/livekit.yaml.
# ⚠️  This is a LOCAL/DEV key pair. Generate a SEPARATE pair via OCI Vault for production —
#     do not reuse this pair when deploying to OCI.
LIVEKIT_API_KEY=your_livekit_api_key_placeholder
LIVEKIT_API_SECRET=your_livekit_api_secret_placeholder
# Dev: ws://127.0.0.1:7880  |  OCI: wss://your-oci-domain.com (behind nginx TLS)
LIVEKIT_URL=ws://127.0.0.1:7880

# ----- 2Checkout (Verifone Payment Gateway) -----
TWOCHECKOUT_VENDOR_ID=your_vendor_id_here
TWOCHECKOUT_SECRET_WORD=your_secret_word_here

# ----- Redis (Cache / Async) -----
# A-P7-06: Redis now requires a password. Set a strong value before deploying.
# REDIS_URL format with auth: redis://:PASSWORD@HOST:PORT/DB
REDIS_PASSWORD=changeme_redis_password
REDIS_URL=redis://:changeme_redis_password@redis:6379/0

# ----- AI / External Services -----
# A-P4-02: ai_bot module is not yet implemented.
# When the OpenAI integration is built, set a real key here.
# Leave commented out until then — a fake key causes AuthenticationError at runtime.
# OPENAI_API_KEY=sk-your-real-key-here

# ----- Sentry (R-R5-01: Error Monitoring) -----
# Leave blank for local dev and CI — the app runs fine without it.
# In production: set to your project's ingest DSN from sentry.io > Settings > DSN.
# Format: https://<public-key>@<host>/project-id
# SENTRY_TRACES_SAMPLE_RATE: 0.0–1.0 (fraction of requests traced for performance).
#   Start at 0.1 (10 %) and tune based on volume and Sentry quota.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=
DJANGO_ENVIRONMENT=development
